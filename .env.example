# Copy this file to `.env` (same directory as stat_arb_bot.py) and fill in
# the keys you have. Any blank/missing key disables that provider only --
# the bot still runs on whatever providers are configured.

# ---------------------------------------------------------------------------
# Quiver Quantitative -- Congressional trades + WSB mentions + Twitter
#   Sign up: https://api.quiverquant.com
#   Cost:    free trial; paid tiers ~$10-50/month
#   Powers:  CongressProvider (preferred path), WSBProvider
# ---------------------------------------------------------------------------
QUIVER_API_KEY=

# ---------------------------------------------------------------------------
# FRED API -- VIX, Financial Conditions Index, yields
#   Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
#   Cost:    FREE
#   Powers:  FredProvider (macro overlay -> size + threshold)
# ---------------------------------------------------------------------------
FRED_API_KEY=

# ---------------------------------------------------------------------------
# NewsAPI -- recent headlines (lexicon sentiment scoring)
#   Sign up: https://newsapi.org/register
#   Cost:    Free tier 100 req/day (sufficient at hourly cadence)
#   Powers:  NewsProvider
# ---------------------------------------------------------------------------
NEWSAPI_KEY=

# If both QUIVER_API_KEY is blank, CongressProvider falls back to the free
# senate-stock-watcher + house-stock-watcher S3 JSON dumps (no key needed).
